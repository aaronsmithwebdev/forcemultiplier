{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/archive",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/resubscriptions",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sync",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/unsubscribes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/campaign-sends",
      "schedule": "* * * * *"
    }
  ]
}
