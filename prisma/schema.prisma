datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["forcemultiplier"]
}
generator client {
  provider = "prisma-client-js"
}
model Connection {
  provider String @id
  clientId String
  secret String
  loginUrl String
  version Int @default(1)
  tokens String?
  externalId String?
  label String?
  instanceUrl String?
  expiresAt DateTime?
  checkedAt DateTime?
  refreshLeaseUntil DateTime?
  error String?
  updatedAt DateTime @updatedAt
  @@schema("forcemultiplier")
}
model OAuthAttempt {
  id String @id
  userId String
  provider String
  verifier String
  connectionVersion Int
  expiresAt DateTime
  @@schema("forcemultiplier")
}
model Audience {
  id String @id @default(cuid())
  name String
  sourceType String
  sourceId String?
  query String
  fields Json @default("[]")
  orgId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs PullRun[]
  deliveries DeliveryRun[]
  @@schema("forcemultiplier")
}
model DeliveryRun {
  id String @id @default(cuid())
  audienceId String
  audience Audience @relation(fields:[audienceId], references:[id], onDelete:Cascade)
  sourceRunId String
  accountId String
  listId String
  listName String
  status String @default("pending")
  cursor String?
  activityId String?
  activityProgress Int @default(0)
  batch Json?
  total Int
  processed Int @default(0)
  submitted Int @default(0)
  skipped Int @default(0)
  failed Int @default(0)
  error String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([audienceId,createdAt])
  @@schema("forcemultiplier")
}
model PullRun {
  id String @id @default(cuid())
  audienceId String
  audience Audience @relation(fields:[audienceId], references:[id], onDelete:Cascade)
  status String @default("pending")
  query String
  fields Json
  orgId String
  cursor String?
  total Int @default(0)
  processed Int @default(0)
  error String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  members AudienceMember[]
  @@index([audienceId,createdAt])
  @@schema("forcemultiplier")
}
model AudienceMember {
  runId String
  run PullRun @relation(fields:[runId], references:[id], onDelete:Cascade)
  salesforceId String
  email String?
  name String?
  optedOut Boolean @default(false)
  data Json
  @@id([runId,salesforceId])
  @@schema("forcemultiplier")
}
