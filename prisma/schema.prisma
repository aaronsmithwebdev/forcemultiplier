datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas = ["forcemultiplier"]
}
generator client {
  provider = "prisma-client-js"
}
model Connection {
  provider String @id
  clientId String
  secret String
  loginUrl String
  version Int @default(1)
  tokens String?
  externalId String?
  label String?
  instanceUrl String?
  expiresAt DateTime?
  checkedAt DateTime?
  refreshLeaseUntil DateTime?
  error String?
  updatedAt DateTime @updatedAt
  @@schema("forcemultiplier")
}
model OAuthAttempt {
  id String @id
  userId String
  provider String
  verifier String
  connectionVersion Int
  expiresAt DateTime
  @@schema("forcemultiplier")
}
model Audience {
  id String @id @default(cuid())
  name String
  sourceType String
  sourceId String?
  query String
  fields Json @default("[]")
  orgId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs PullRun[]
  deliveries DeliveryRun[]
  managedLists ManagedList[]
  schedule SyncSchedule?
  @@schema("forcemultiplier")
}
model SyncSchedule {
  id String @id @default(cuid())
  audienceId String @unique
  audience Audience @relation(fields:[audienceId], references:[id], onDelete:Cascade)
  accountId String
  listId String
  listName String
  mappings Json @default("[]")
  cadence String
  intervalHours Int?
  localTime String?
  weekday Int?
  timeZone String
  enabled Boolean @default(true)
  version Int @default(1)
  nextRunAt DateTime
  lastRunAt DateTime?
  lastCompletedAt DateTime?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs SyncRun[]
  @@index([enabled,nextRunAt])
  @@schema("forcemultiplier")
}
model SyncRun {
  id String @id @default(cuid())
  scheduleId String
  schedule SyncSchedule @relation(fields:[scheduleId], references:[id], onDelete:Cascade)
  scheduleVersion Int
  status String @default("pending")
  manual Boolean @default(false)
  scheduledFor DateTime
  accountId String
  listId String
  listName String
  mappings Json @default("[]")
  pullRunId String?
  deliveryRunId String?
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  error String?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([status,availableAt])
  @@index([scheduleId,createdAt])
  @@schema("forcemultiplier")
}
model DeliveryRun {
  id String @id @default(cuid())
  audienceId String
  audience Audience @relation(fields:[audienceId], references:[id], onDelete:Cascade)
  issues DeliveryIssue[]
  sourceRunId String
  accountId String
  listId String
  listName String
  managedListId String?
  managedList ManagedList? @relation(fields:[managedListId], references:[id], onDelete:SetNull)
  status String @default("pending")
  cursor String?
  activityId String?
  activityKind String?
  activityProgress Int @default(0)
  batch Json?
  mappings Json @default("[]")
  total Int
  processed Int @default(0)
  submitted Int @default(0)
  skipped Int @default(0)
  failed Int @default(0)
  removed Int @default(0)
  reconcileCursor String?
  reconcileScannedAt DateTime?
  error String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  @@index([audienceId,createdAt])
  @@schema("forcemultiplier")
}
model DeliveryIssue {
  deliveryId String
  delivery DeliveryRun @relation(fields:[deliveryId], references:[id], onDelete:Cascade)
  key String
  category String
  reason String
  salesforceId String?
  name String?
  email String?
  detail String?
  createdAt DateTime @default(now())
  @@id([deliveryId,key])
  @@index([deliveryId,category])
  @@schema("forcemultiplier")
}
model ManagedList {
  id String @id @default(cuid())
  accountId String
  listId String
  listName String
  audienceId String
  audience Audience @relation(fields:[audienceId], references:[id], onDelete:Cascade)
  initializedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ManagedListMember[]
  deliveries DeliveryRun[]
  @@unique([accountId,listId])
  @@schema("forcemultiplier")
}
model ManagedListMember {
  managedListId String
  managedList ManagedList @relation(fields:[managedListId], references:[id], onDelete:Cascade)
  email String
  contactId String
  seenDeliveryId String
  desiredDeliveryId String?
  @@id([managedListId,email])
  @@index([managedListId,seenDeliveryId])
  @@index([managedListId,desiredDeliveryId])
  @@schema("forcemultiplier")
}
model PullRun {
  id String @id @default(cuid())
  audienceId String
  audience Audience @relation(fields:[audienceId], references:[id], onDelete:Cascade)
  status String @default("pending")
  query String
  fields Json
  orgId String
  cursor String?
  total Int @default(0)
  processed Int @default(0)
  error String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  members AudienceMember[]
  @@index([audienceId,createdAt])
  @@schema("forcemultiplier")
}
model AudienceMember {
  runId String
  run PullRun @relation(fields:[runId], references:[id], onDelete:Cascade)
  salesforceId String
  email String?
  normalizedEmail String?
  name String?
  optedOut Boolean @default(false)
  data Json
  @@id([runId,salesforceId])
  @@index([runId,normalizedEmail])
  @@schema("forcemultiplier")
}
