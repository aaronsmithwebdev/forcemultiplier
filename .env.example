# Copy to .env. Get both connection strings from your Supabase project's Connect panel.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1&schema=forcemultiplier"
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require&schema=forcemultiplier"

# Supabase Connect → App Frameworks → Next.js. The publishable key is safe for browser use.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Exact browser origin and base for both OAuth callbacks. Use HTTPS when hosted.
APP_URL="http://localhost:3000"
# Generated by npm run setup. Keep private and back up; do not rotate casually.
APP_ENCRYPTION_KEY=""

# Optional: API version supported by the connected Salesforce org.
SALESFORCE_API_VERSION="v66.0"

# Salesforce and Constant Contact app credentials are saved through Connections.
# No Supabase secret or service-role key is required.
